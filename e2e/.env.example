# انسخ هذا الملف إلى .env واملأ القيم.
# .env مُستثنى من git — لا تضع كلمات مرور في أي ملف يُدفع.

# عنوان نسخة الاختبار. لا تضع هنا عنوان الإنتاج.
E2E_BASE_URL=https://<نسخة-الاختبار>.netlify.app

# حسابات منشأة الاختبار، بأربعة أدوار
E2E_RECEPTION_EMAIL=
E2E_RECEPTION_PASSWORD=

E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=

E2E_ACCOUNTANT_EMAIL=
E2E_ACCOUNTANT_PASSWORD=

E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

# اختياري: معرّف جولة ثابت (يُولَّد تلقائيًا إن تُرك فارغًا)
E2E_RUN_ID=

# اختياري: معرّف موعد من منشأة أخرى — لتفعيل فحص عزل المنشآت
E2E_FOREIGN_APPOINTMENT_ID=
